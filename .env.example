# Copie para .env e ajuste. NUNCA versione o .env.
# Todas as variáveis são opcionais: sem nenhuma, o projeto roda localmente com SQLite e IA mock.

# --- Geral ----------------------------------------------------------------------------
APP_ENV=development
DATABASE_URL=sqlite:///data/database/ufabc_science.db
LOG_LEVEL=INFO
EDITORIAL_LANGUAGE=pt-BR
TIMEZONE=America/Sao_Paulo

# --- Diretórios (relativos ao diretório de execução) --------------------------------
DATA_DIR=data
EDITIONS_DIR=editions
OUTPUT_DIR=dist
PREVIEW_DIR=build/preview

# --- Fontes científicas (parâmetros do pipeline) ------------------------------------
ENABLED_SOURCES=openalex,pubmed,arxiv,crossref
COLLECTION_DAYS=7
MAX_ARTICLES_PER_SOURCE=100
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=1
# E-mail de contato enviado às APIs (OpenAlex/Crossref/NCBI recomendam). Opcional.
CONTACT_EMAIL=
OPENALEX_EMAIL=

# --- Credenciais (opcionais; nunca coloque valores reais em arquivos versionados) ----
# OpenAlex: chave gratuita com orçamento diário próprio (sem chave = orçamento compartilhado).
OPENALEX_API_KEY=
# NCBI/PubMed: aumenta o limite de 3 para 10 requisições/s.
NCBI_API_KEY=

# --- Inteligência artificial --------------------------------------------------------
# mock = sem rede, rascunhos extrativos para desenvolvimento.
# openai_compatible = qualquer API /v1/chat/completions (ex.: Ollama local, sem custo).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT=60
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000

# --- Classificação, relevância e geração --------------------------------------------
CLASSIFICATION_RULES_PATH=
CLASSIFICATION_MIN_CONFIDENCE=0.35
CLASSIFICATION_UNCERTAIN_BELOW=0.5
PRIORITY_VERY_HIGH=85
PRIORITY_HIGH=70
PRIORITY_MODERATE=50
GENERATION_LIMIT=10
MIN_ABSTRACT_WORDS=40
# JSON opcional, ex.: {"findings": [80, 150], "total": [350, 650]}
GENERATION_WORD_LIMITS=

# --- Automação -----------------------------------------------------------------------
PIPELINE_LOCK_STALE_HOURS=6
